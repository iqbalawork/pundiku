{
  "name": "pundiku",
  "version": "2.0.0",
  "private": true,
  "description": "PundiKu, pencatat keuangan pribadi. Frontend statis untuk GitHub Pages.",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "css": "tailwindcss -i ./src/app.css -o ./assets/css/app.css --minify",
    "build": "npm run icons && npm run css",
    "dev": "tailwindcss -i ./src/app.css -o ./assets/css/app.css --watch"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "tailwindcss": "3.4.17"
  }
}
